msgstr "لا يسحب التسجيلَ إلا صاحبُه أو المسؤول."

#: grader/views_inscriptions.py
msgid "Inscription de %(nom)s retirée du registre."
msgstr "سُحب تسجيل %(nom)s من السجل."

#: grader/views_inscriptions.py
msgid "%(ajoutes)s étudiant(s) ajouté(s) à « %(name)s »"
msgstr "أضيف %(ajoutes)s طالب إلى « %(name)s »"

#: grader/views_inscriptions.py
msgid "%(nom_complet)s est inscrit(e) sous le n° %(numero)s. Sa carte avec QR code est prête."
msgstr "سُجّل %(nom_complet)s تحت الرقم %(numero)s. بطاقته برمز QR جاهزة."

#: grader/views_inscriptions.py
msgid "Cochez au moins un étudiant."
msgstr "أشّر على طالب واحد على الأقل."

#: grader/views_inscriptions.py
msgid " (%(deja)s y figurai%(en)st déjà)"
msgstr " (كان %(deja)s منهم فيها من قبل)"

#: grader/views_inscriptions.py
msgid "Inscription de %(nom)s enregistrée (%(n)s liste(s) de classe ou de concours mise(s) à jour)."
msgstr "سُجّل %(nom)s (حُدّثت %(n)s قائمة قسم أو مناظرة)."

#: grader/views_inscriptions.py
msgid "Inscription de %(nom)s enregistrée."
msgstr "سُجّل %(nom)s."

