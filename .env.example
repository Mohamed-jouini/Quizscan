# Copiez ce fichier en .env et adaptez-le à votre serveur :
#   cp .env.example .env && nano .env
# .env n'est jamais envoyé sur GitHub ni écrasé par une mise à jour.

# ---------------------------------------------------------------------------
# OBLIGATOIRE en production : sans ces deux lignes, l'application refuse de
# démarrer (le message dans « docker compose logs quizscan » le dit).
# ---------------------------------------------------------------------------

# Longue chaîne aléatoire, propre à ce serveur. Pour en générer une :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changez-moi-longue-chaine-aleatoire

# Tous les noms d'hôte et IP par lesquels on accède à l'application.
ALLOWED_HOSTS=quiz.mon-etablissement.tn,192.168.1.10,localhost

# ---------------------------------------------------------------------------
# Accès
# ---------------------------------------------------------------------------

# Origines https de confiance (le domaine servi par le reverse proxy).
CSRF_TRUSTED_ORIGINS=https://quiz.mon-etablissement.tn

# Sous-chemin derrière le reverse proxy. LAISSEZ VIDE si l'application a son
# propre domaine ou sous-domaine (https://quiz.mon-etablissement.tn/) — c'est
# le cas le plus courant. Ne renseignez /quizscan que si elle est servie sous
# un sous-chemin (https://mon-etablissement.tn/quizscan/) avec un
# « uri strip_prefix /quizscan » côté Caddy.
URL_PREFIX=

# Où publier l'application.
#   - derrière un reverse proxy sur le même serveur (recommandé) :
#       QUIZSCAN_BIND=127.0.0.1  QUIZSCAN_PORT=5011
#   - accès direct depuis le réseau, sans reverse proxy :
#       QUIZSCAN_BIND=0.0.0.0    QUIZSCAN_PORT=80
QUIZSCAN_BIND=127.0.0.1
QUIZSCAN_PORT=5011

# Mettez 0 UNIQUEMENT si l'application est jointe en http:// (accès direct par
# l'adresse IP sur un réseau local, sans TLS). Sinon le navigateur refuse de
# renvoyer le cookie de session et la connexion boucle sans message d'erreur.
# À ne faire que sur un réseau de confiance.
HTTPS=1

# --- Facultatif : redirection http -> https ---------------------------------
# Normalement assurée par le reverse proxy (Caddy). Mettez 1 seulement si
# votre proxy ne le fait pas.
# SECURE_SSL_REDIRECT=0

# --- Facultatif : PostgreSQL au lieu de SQLite (usage intensif) -------------
# Laissez ces lignes commentées pour conserver la base SQLite de data/.
# POSTGRES_DB=quizscan
# POSTGRES_USER=quizscan
# POSTGRES_PASSWORD=mot-de-passe-de-la-base
# POSTGRES_HOST=db
# POSTGRES_PORT=5432


# ---------------------------------------------------------------------------
# Sauvegardes (deploy/sauvegarde.sh, chaque nuit — voir README)
# ---------------------------------------------------------------------------

# Nombre d'archives conservées, sur ce serveur et sur la copie.
SAUVEGARDE_GARDER=7

# Second support où recopier chaque archive : partage réseau, NAS, disque
# externe monté. FORTEMENT conseillé — une sauvegarde restée sur le disque
# qu'elle protège disparaît avec lui. Laissez vide pour ne pas copier.
SAUVEGARDE_COPIE=

# ---------------------------------------------------------------------------
# Mises à jour automatiques (deploy/update.sh)
# ---------------------------------------------------------------------------

# 1 : la suite de tests tourne dans la nouvelle image avant chaque mise à
# jour ; si elle échoue, l'ancienne version reste en service. Ajoute quelques
# minutes à chaque mise à jour.
TESTS_AVANT_MISE_A_JOUR=0
